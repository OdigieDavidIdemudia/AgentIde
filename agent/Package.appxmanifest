<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity
    Name="AgentIDEProject.AgentIDE"
    Publisher="CN=AgentIDE Project"
    Version="0.2.0.0" />

  <Properties>
    <DisplayName>AgentIDE EDR/XDR Assessment Agent</DisplayName>
    <PublisherDisplayName>AgentIDE Project</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>AgentIDE EDR/XDR Assessment Agent - Security assessment framework for evaluating EDR/XDR products</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="AgentIDE" Executable="agentide.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="AgentIDE"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="AgentIDE EDR/XDR Assessment Agent"
        BackgroundColor="#0066CC" />
      <Extensions>
        <desktop:Extension Category="windows.fullTrustProcess" Executable="agentide.exe">
          <desktop:FullTrustProcess>
            <desktop:ParameterGroup GroupId="InstallService" Parameters="--install" />
          </desktop:FullTrustProcess>
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>
</Package>