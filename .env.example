# ── Dashboard server ──────────────────────────────────────────────────
# PostgreSQL connection — use either DATABASE_URL or the individual PG* vars.
# DATABASE_URL=postgres://postgres:change-me@localhost:5432/postgres
PGHOST=localhost
PGPORT=5432
# Matches dashboard/docker-compose.yml
PGUSER=agentide
PGPASSWORD=agentide_password
PGDATABASE=agentide

# Shared secret agents must present to connect to wss://<dashboard>/agent.
# Generate one with: node -e "console.log(require('crypto').randomUUID())"
AGENT_TOKEN=

# Dashboard admin login. The default password is a first-run dev placeholder —
# change it for any real deployment.
ADMIN_EMAIL=admin@agentide.local
ADMIN_PASSWORD=agentide-dev

# Comma-separated origins allowed for CORS and the /dashboard WebSocket
# Origin check. Empty = same-origin only.
CORS_ORIGINS=http://localhost:3000

# Gemini API key for AI report generation (scripts/generate_ai_report.py)
GEMINI_API_KEY=

PORT=8080
